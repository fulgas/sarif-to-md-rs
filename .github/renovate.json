{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prConcurrentLimit": 3,
  "schedule": [
    "* 0-5 1,15 * *"
  ],
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Set a sensible default for all Cargo packages",
      "matchDatasources": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group all major dependency updates into one PR for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Major Dependencies",
      "semanticCommitType": "feat",
      "automerge": false
    },
    {
      "description": "Group minor/patch updates for Cargo dependencies",
      "matchDatasources": [
        "cargo"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Dependencies",
      "semanticCommitType": "fix"
    },
    {
      "description": "Group and auto-merge minor/patch updates for Cargo dev-dependencies (no release)",
      "matchDatasources": [
        "cargo"
      ],
      "matchDepTypes": [
        "dev-dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Dev dependencies",
      "semanticCommitType": "chore",
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates (no release)",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "chore"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 0-5 1,15 * *"
    ]
  }
}
