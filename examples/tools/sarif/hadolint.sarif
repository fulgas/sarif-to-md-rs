{"$schema":"http://json.schemastore.org/sarif-2.1.0","runs":[{"defaultSourceLanguage":"dockerfile","results":[{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":1,"sourceLanguage":"dockerfile","startColumn":1,"startLine":1}}}],"message":{"text":"Using latest is prone to errors if the image will ever update. Pin the version explicitly to a release tag"},"ruleId":"DL3007"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Pin versions in apt get install. Instead of `apt-get install <package>` use `apt-get install <package>=<version>`"},"ruleId":"DL3008"},{"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Avoid additional packages by specifying `--no-install-recommends`"},"ruleId":"DL3015"},{"level":"note","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":2,"sourceLanguage":"dockerfile","startColumn":1,"startLine":2}}}],"message":{"text":"Delete the apt lists (/var/lib/apt/lists) after installing something"},"ruleId":"DL3009"},{"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":3,"sourceLanguage":"dockerfile","startColumn":1,"startLine":3}}}],"message":{"text":"Use COPY instead of ADD for files and folders"},"ruleId":"DL3020"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":5,"sourceLanguage":"dockerfile","startColumn":1,"startLine":5}}}],"message":{"text":"Avoid use of cache directory with pip. Use `pip install --no-cache-dir <package>`"},"ruleId":"DL3042"},{"level":"warning","locations":[{"physicalLocation":{"artifactLocation":{"uri":"Dockerfile"},"region":{"endColumn":1,"endLine":6,"sourceLanguage":"dockerfile","startColumn":1,"startLine":6}}}],"message":{"text":"Use arguments JSON notation for CMD and ENTRYPOINT arguments"},"ruleId":"DL3025"}],"tool":{"driver":{"downloadUri":"https://github.com/hadolint/hadolint","fullName":"Haskell Dockerfile Linter","name":"Hadolint","shortDescription":{"text":"Dockerfile linter, validate inline bash, written in Haskell"},"version":"2.14.0"}}}],"version":"2.1.0"}